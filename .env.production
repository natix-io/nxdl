BASE_URL=https://ryujin.natix.network/alduin/api
API_KEY=<API_KEY>
DATASET_ID=<DATASET_ID>
API_TIMEOUT=60.0
DOWNLOAD_TIMEOUT=120.0
DOWNLOAD_CHUNK_SIZE=65536
MAX_PARALLEL_TRIPS=4
MAX_PARALLEL_FILES=2
CACHE_DIR=./cache
OUTPUT_DIR=./dataset
DRY_MODE=false
# Proceed when the output filesystem provides no flock (Lustre without -o flock, NFS without lockd).
# Off by default: two unlocked runs of one dataset share a ledger and cache and delete each other's .part files.
ALLOW_UNLOCKED_RUNS=false
# QA (python -m app.validate) — trips validated concurrently. QA is metadata
# calls and nothing else, so on a network filesystem the scan is latency-bound
# and threads recover most of it. 1 restores the serial pass.
QA_WORKERS=8
# How many downloaded trips QA checks file-by-file against their trip manifests
# (one API request each). 0 = every trip; sampling is opt-in, because a sample
# cannot decide a PASS/FAIL verdict.
MANIFEST_FILE_SAMPLE=0
# Which cameras to keep from what the server manifest returns for each minute:
#   all        = every camera the manifest has (default)
#   front      = front camera only
#   front_rear = front + rear (back) only
CAMERA_SELECTION=all
# Optional JSON file selecting a subset of trips and, per trip, minutes (see README). Empty = whole dataset.
TRIPS_FILE=
# Write safety_critical_events_manifest.json into the dataset root after the run (local downloads only).
CREATE_MANIFEST=false
# Empty = keep trips local; set to s3://bucket/optional/prefix to upload each trip to S3 and delete the local copy.
S3_UPLOAD=
# AWS access key id (optional; blank = use the standard AWS credential chain).
AWS_ACCESS_KEY_ID=
# AWS secret access key (optional; pairs with AWS_ACCESS_KEY_ID).
AWS_SECRET_ACCESS_KEY=
# AWS region of the target bucket, e.g. eu-central-1 (optional).
AWS_REGION=
# Custom S3-compatible endpoint for non-AWS storage like R2/MinIO (optional; blank = AWS S3).
AWS_ENDPOINT_URL=
